<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android">
    <PreferenceCategory
        android:summary="Settings for table view"
        android:title="Table view settings">
        <EditTextPreference
            android:id="@+id/table_row_count"
            android:defaultValue="50"
            android:key="@string/preference_settings_table_row_count_key"
            android:maxLength="3"
            android:numeric="integer"
            android:summary="@string/preference_settings_table_row_count_summary"
            android:title="@string/preference_settings_table_row_count_title" />
    </PreferenceCategory>

    <PreferenceCategory
        android:summary="Settings for splash screen"
        android:title="Splash Screen">
        <SwitchPreference
            android:defaultValue="true"
            android:key="@string/preference_settings_splash_screen_key"
            android:summary="@string/preference_settings_splash_screen_summary"
            android:title="@string/preference_settings_splash_screen_title" />
    </PreferenceCategory>

</PreferenceScreen>